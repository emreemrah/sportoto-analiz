# Bu dosyayı KOPYALA, adını ".env" yap ve kendi değerlerini gir.
# .env dosyası .gitignore ile korunur, asla paylaşılmaz.

# FootyStats API anahtarın (Hobby paketinden). Kendi anahtarını buraya yaz.
# Anahtarın yoksa "example" yazarsan örnek lig (Premier Lig örneği) ile çalışır.
FOOTYSTATS_API_KEY=example

# API-Football (api-sports.io) anahtarı — canlı skor + dakika bilgisi için.
# dashboard.api-football.com'dan alınır. BOŞ bırakılırsa canlı skor kapanır,
# uygulamanın geri kalanı normal çalışır.
APIFOOTBALL_API_KEY=

# Backend hangi portta çalışsın
PORT=4000

# FootyStats'ten kaç saatte bir veri yenilensin (limiti korumak için)
REFRESH_HOURS=6

# Claude (Anthropic) API anahtarı — maç yorumlarını AI üretsin diye.
# console.anthropic.com'dan alınır, "sk-ant-..." ile başlar.
# BOŞ bırakırsan AI yorumu kapanır, kural-tabanlı yorum kullanılır.
ANTHROPIC_API_KEY=
# Kullanılacak model (varsayılan en yetenekli Opus). İstersen claude-haiku-4-5 ile ucuzlat.
AI_MODEL=claude-opus-4-8

# Analiz edilecek FootyStats lig/sezon id'leri (virgülle ayır, en fazla 50).
# "example" anahtarıyla sadece 2012 çalışır. Kendi anahtarınla Süper Lig vb. eklersin.
FOOTYSTATS_SEASON_IDS=2012

# --- Üyelik + profil + yorum sistemi (Supabase) ---
# supabase.com'da ücretsiz proje aç → Project Settings > API'den al.
# Boş bırakırsan üyelik/yorum uçları kapanır (uygulama yine çalışır).
# Ayrıca: 'avatars' adında public Storage bucket + profiles/comments/comment_likes tabloları gerekir.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Moderasyon operatörü (Topluluk Kuralları / Google Play üçüncü şart) ---
# Bildirimleri inceleyebilecek hesapların e-posta adresleri. Virgül, noktalı
# virgül veya boşlukla ayrılır. Yetki UYGULAMAYA GÖMÜLMEZ; yalnız burada durur.
#
# KAPI KAPALI BAŞLAR: bu satır boşsa ya da bozuksa HİÇ KİMSE operatör değildir
# (/api/moderation/* uçları herkese 403 döner). Joker (*) kabul edilmez ve
# alt-dize eşleşmesi yapılmaz; adresin TAM olarak eşleşmesi gerekir.
#
# Adresin Supabase'de KAYITLI ve DOĞRULANMIŞ olması şarttır: doğrulanmamış
# adresle giriş mümkün olduğu için, aksi hâlde listedeki adresi başkası kendine
# kaydedip yetkiyi devralabilirdi.
MODERATOR_EMAILS=

# Yasal sayfalardaki {{DESTEK_EPOSTA}} yer tutucusunun karşılığı
# (/gizlilik, /hesap-silme, /topluluk-kurallari). Boş bırakılırsa uydurma adres
# YAZILMAZ; kullanıcıya mağaza sayfasındaki iletişim adresi gösterilir.
SUPPORT_EMAIL=

# --- Bülten Arşivi + Değişmez Snapshot Motoru ---
# Kalıcı arşiv sürücüsü: boş = otomatik (Supabase varsa supabase, yoksa dosya).
# 'file' → backend/data/archive (geliştirme; Render free'de KALICI DEĞİL).
ARCHIVE_DRIVER=

# POST /api/internal/bulletins/:id/freeze ucunun servis anahtarı.
# Boş bırakılırsa uç yalnız sunucunun kendisinden (localhost) çağrılabilir.
INTERNAL_API_KEY=

# Master Analiz deposu (profiller/kullanıcı analizleri/backtest):
# boş = otomatik (Supabase varsa supabase, yoksa dosya: backend/data/analysis).
ANALYSIS_DRIVER=

# --- Otomatik migration (veritabanı şeması) ---
# Backend AÇILIŞTA backend/migrations/*.sql dosyalarını sırayla ve otomatik uygular.
# Elle SQL çalıştırmak GEREKMEZ. Bunun için doğrudan PostgreSQL bağlantısı şarttır:
# yukarıdaki SUPABASE_URL/SECRET_KEY PostgREST üzerinden konuşur ve PostgREST
# CREATE TABLE / CREATE TRIGGER / ALTER TABLE gibi DDL'i ÇALIŞTIRAMAZ.
#
# Supabase panelinde: Project Settings > Database > Connection string >
# **Session / Direct** bağlantı (5432). 6543 portundaki "Transaction pooler"
# DDL için uygun DEĞİLDİR.
#
# Tanımlı değilse: migration uygulanmaz, backend worker/scheduler'ları BAŞLAMAZ
# ve durum /api/health içinde bildirilir (gizli bilgi yazılmadan).
# SUPABASE_DB_URL=postgresql://postgres:<parola>@db.<proje>.supabase.co:5432/postgres

# Migration ince ayarları (hepsi isteğe bağlı, varsayılanlar güvenlidir):
# MIGRATION_LOCK_WAIT_MS=120000       # başka kopya uyguluyorsa en fazla bu kadar bekle
# MIGRATION_LOCK_TIMEOUT_MS=30000     # tek bir DDL kilit için en fazla bu kadar bekle
# MIGRATION_CONNECT_TIMEOUT_MS=15000
# MIGRATION_STATEMENT_TIMEOUT_MS=120000
