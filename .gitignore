# YAYIN İMZASI — parola ve anahtar deposu ASLA depoya girmez.
android/key.properties
*.jks
*.keystore

# YAYIN SEMBOLLERİ — .symbols dosyaları depoda DURMAZ (her biri ~3 MB ve
# derleme çıktısıdır), ama SAKLANMALARI ZORUNLUDUR: karartılmış bir sürümün
# çökme raporu ancak kendi sembol dosyasıyla okunabilir ve geriye dönük
# üretilemez. Yayınlanan her sürümün sembollerini derleme sisteminde /
# yedekte tutun. Ayrıntı: yayin-sembolleri/BENIOKU.md
yayin-sembolleri/**/*.symbols

# KULLANILMAYAN GÖRSELLER — DİSKTE DURUR, DEPOYA GİRMEZ.
#
# Bu dosyalar kaynak Expo uygulamasından kopyalandı ama ne burada ne KAYNAKTA
# kullanılıyor (hero-*: hiç import edilmiyor · ic-*/icons/: birbirinin kopyası
# ve ölü · tab-stadium/tab-analysis: kaynakta TAB_ICONS'ta tanımlı ama hiç
# çizilmiyor, o iki sekme SVG/CustomPainter ikon kullanır). Toplam ~12 MB ve
# uygulama paketine de girmiyorlar (pubspec'te listeli değiller).
#
# Gerekirse kaynak depodan (app/assets) yeniden alınabilir. Launcher/açılış
# ikonlarını ÜRETEN dosyalar assets/brand/ altındadır ve depoda DURUR.
assets/hero-*.png
assets/ic-*.png
assets/icons/
assets/tab-stadium.png
assets/tab-analysis.png
assets/icon.png
assets/splash-icon.png
assets/favicon.png
assets/android-icon-*.png

# SPOR VERİSİ SKILL'LERİ (machina-sports/sports-skills) — DEPOYA GİRMEZ.
#
# `.agents/skills/` upstream'den `npx skills add` ile kurulan skill
# dosyalarıdır (football-data · betting · sports-reporter · sports-news);
# `.claude/skills/` altındaki aynı adlı girdiler oraya symlink'tir.
# `skills-lock.json` bu kurulumun kayıt dosyasıdır.
#
# Bunlar proje kaynak kodu değil, dışarıdan çekilen bağımlılıktır — kurulum
# şu komutla tekrarlanır:
#   npx skills add machina-sports/sports-skills --skill <ad> --yes
#
# Kurulum anındaki upstream sürümü .claude/skills/spor-toto-data-research/
# references/calisma-zamani.md dosyasında yazılıdır (commit SHA dahil); o
# dosya DEPODA DURUR, böylece aynı sürüm yeniden kurulabilir.
.agents/
skills-lock.json

# Yukarıdaki upstream skill'lerin `.claude/skills/` altındaki SYMLINK'leri de
# depoya girmez: hedefleri `.agents/` altında ve o klasör izlenmiyor — link
# depoda kalsaydı klonlayan kişide KIRIK olurdu. Kurulum komutu bu linkleri
# yeniden oluşturur. (Bizim yazdığımız `spor-toto-*` wrapper'ları GERÇEK
# klasördür ve depoda DURUR.)
.claude/skills/football-data
.claude/skills/betting
.claude/skills/sports-reporter
.claude/skills/sports-news
