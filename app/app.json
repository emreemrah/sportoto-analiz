{
  "expo": {
    "name": "Sportoto Master Analiz",
    "slug": "sportoto-master-analiz",
    "scheme": "sportotomasteranaliz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#0B1B3A",
    "description": "15 maçlık haftalık bültenler için bağımsız analiz ve tahmin destek uygulaması. Hiçbir kurum, operatör veya veri sağlayıcı tarafından hazırlanmamış, desteklenmemiş veya onaylanmamıştır.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emrahanlar.masteranaliz",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Uygulama kilidini açmak için Face ID kullanılır. Yüz verisi cihazdan asla çıkmaz ve uygulama tarafından kaydedilmez."
      }
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Uygulama kilidini açmak için Face ID kullanılır. Yüz verisi cihazdan asla çıkmaz ve uygulama tarafından kaydedilmez."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0B1B3A"
        }
      ],
      "expo-font",
      "expo-sharing"
    ],
    "android": {
      "package": "com.emrahanlar.masteranaliz",
      "versionCode": 1,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B1B3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "name": "Sportoto Master Analiz",
      "shortName": "Master Analiz",
      "lang": "tr",
      "themeColor": "#0B1B3A",
      "backgroundColor": "#0B1B3A",
      "description": "15 maçlık haftalık bültenler için bağımsız analiz ve tahmin destek uygulaması.",
      "favicon": "./assets/favicon.png"
    }
  }
}
